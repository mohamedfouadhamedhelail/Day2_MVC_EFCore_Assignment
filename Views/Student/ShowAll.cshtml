@model IEnumerable<Day2_MVC_EFCore_Assignment.Models.Student>

@{
	ViewData["Title"] = "All Students";
}

<h1>All Students</h1>

<table class="table table-bordered table-striped">
	<thead>
		<tr>
			<th>ID</th>
			<th>Name</th>
			<th>Age</th>
			<th>Department</th>
			<th>Details</th>
		</tr>
	</thead>

	
	<tbody>
		@foreach (var student in Model)
		{
			<tr>
				<td>@student.Id</td>
				<td>@student.Name</td>
				<td>@student.Age</td>
				<td>@student.Department?.Name</td>
				<td>
					<a href="/Student/ShowDetails?id=@student.Id">
						Show Details
					</a>
				</td>
			</tr>
		}
	</tbody>
	

</table>
